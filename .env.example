# ───────────── NEO BOT ─────────────
BOT_NAME=NEO BOT
BOT_PREFIX=.
BOT_WEBSITE=https://github.com

# Owner numbers, international format without "+", comma separated
OWNER_NUMBERS=212XXXXXXXXX

# ───────────── Security (REQUIRED) ─────────────
# 64 hex chars (32 bytes). Generate: npm run genkey
# Losing this key = the saved session can no longer be read (you must link again).
SESSION_ENCRYPTION_KEY=

# ───────────── Authentication ─────────────
# Leave empty to choose in the terminal / web setup page. Or: qr | phone
AUTH_METHOD=
# Used only when AUTH_METHOD=phone (country code included, digits only)
PAIRING_NUMBER=

# ───────────── Web setup page (cloud hosting) ─────────────
# Enabled automatically when there is no terminal.
WEB_SETUP_ENABLED=
PORT=3000
# Long random secret. Open: https://your-host/?token=THIS_VALUE
WEB_SETUP_TOKEN=

# ───────────── Storage ─────────────
# Recommended on free hosts (Render free wipes local files):
# MongoDB Atlas connection string. When set, the ENCRYPTED session is stored there.
MONGODB_URI=
MONGODB_DB=neobot
# Used only when MONGODB_URI is empty. Must be on a PERSISTENT disk/volume.
SESSION_DIR=storage/sessions

# ───────────── Keep-alive (free hosts) ─────────────
# Public URL of this service. Render fills RENDER_EXTERNAL_URL automatically.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=600000

# ───────────── Anti-ban (outgoing message governor) ─────────────
ANTIBAN_ENABLED=true
ANTIBAN_PER_MINUTE=20
ANTIBAN_PER_HOUR=400
ANTIBAN_BURST=5
ANTIBAN_CHAT_GAP_MS=700
# Never open a private chat with someone who has not written to the bot first.
ANTIBAN_BLOCK_COLD_DM=true
# ───────────── Session cleanup ─────────────
# Stale disposable entries (old chat sessions, group keys) are removed when the
# session grows past the threshold. creds.json, pre-keys and app-state keys are never removed.
SESSION_CLEAN_ENABLED=true
SESSION_CLEAN_THRESHOLD=500
SESSION_CLEAN_MIN_AGE_HOURS=24
SESSION_CLEAN_INTERVAL_MS=3600000
# ───────────── Reconnection ─────────────
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
# 0 = unlimited
RECONNECT_MAX_ATTEMPTS=0

# ───────────── Logging ─────────────
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
LOG_PRETTY=

# Owner-only remote code console (.dev). Set to false to disable.
DEVTOOLS_ENABLED=true

# Main owner saved to data/owners.json on first run
MAIN_OWNER=212721063675

# ───────────── Media (optional) ─────────────
# ffmpeg is needed for .sticker from images/videos, .toimage and .tomp3.
# Termux: pkg install ffmpeg. Leave empty to use "ffmpeg" from PATH.
FFMPEG_PATH=
STICKER_PACK=NEO BOT
STICKER_AUTHOR=

# ───────────── AI chat (optional) ─────────────
# Any OpenAI-compatible API. .ai stays disabled while AI_API_KEY is empty.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=
