# ───────────── NEO BOT ─────────────
BOT_NAME=NEO BOT
BOT_PREFIX=.
BOT_WEBSITE=https://github.com

# Owner numbers, international format without "+", comma separated
OWNER_NUMBERS=212XXXXXXXXX

# ───────────── Security (REQUIRED) ─────────────
# 64 hex chars (32 bytes). Generate: npm run genkey
# Losing this key = the saved session can no longer be read (you must link again).
SESSION_ENCRYPTION_KEY=

# ───────────── Authentication ─────────────
# Leave empty to choose in the terminal / web setup page. Or: qr | phone
AUTH_METHOD=
# Used only when AUTH_METHOD=phone (country code included, digits only)
PAIRING_NUMBER=

# ───────────── Web setup page (cloud hosting) ─────────────
# Enabled automatically when there is no terminal.
WEB_SETUP_ENABLED=
PORT=3000
# Long random secret. Open: https://your-host/?token=THIS_VALUE
WEB_SETUP_TOKEN=

# ───────────── Storage ─────────────
# Must be on a PERSISTENT disk/volume in production.
SESSION_DIR=storage/sessions

# ───────────── Reconnection ─────────────
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
# 0 = unlimited
RECONNECT_MAX_ATTEMPTS=0

# ───────────── Logging ─────────────
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
LOG_PRETTY=
